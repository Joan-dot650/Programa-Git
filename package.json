  "private": true,
  "description": "Entrega de módulos integrados RaízVolt - GA8-AA1-EV02",
  "author": "Jhon Edwards Tineo Landaeta",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
