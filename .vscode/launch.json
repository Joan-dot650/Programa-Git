{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "RaizVolt: servidor fuente",
      "program": "${workspaceFolder}/src/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000",
        "DB_PATH": "${workspaceFolder}/data/desarrollo.sqlite"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}