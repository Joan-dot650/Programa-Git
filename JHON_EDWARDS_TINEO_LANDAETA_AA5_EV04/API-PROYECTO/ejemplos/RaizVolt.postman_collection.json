{
  "info": {
    "name": "RaízVolt API - recorrido completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "34 solicitudes. Primero preparar demo, configurar credenciales ADMIN y ejecutar en orden. Los datos creados son ficticios. No exportar tokens ni credenciales reales."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "admin_usuario",
      "value": ""
    },
    {
      "key": "admin_contrasena",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/salud"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{admin_usuario}}\",\n  \"contrasena\": \"{{admin_contrasena}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"admin_token\", pm.response.json().token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"admin_usuario\") || !pm.collectionVariables.get(\"admin_contrasena\")) throw new Error(\"Ejecuta PREPARAR_DEMO_WINDOWS.bat y copia las credenciales en las variables de la colección.\");",
              "pm.collectionVariables.set(\"sufijo\", Date.now().toString(36) + Math.random().toString(36).slice(2,6));",
              "pm.collectionVariables.set(\"cliente_usuario\", \"cliente.\" + pm.collectionVariables.get(\"sufijo\"));"
            ]
          }
        }
      ]
    },
