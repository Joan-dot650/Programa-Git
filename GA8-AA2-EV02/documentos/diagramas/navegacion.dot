digraph G {graph [bgcolor="white",pad=.25,nodesep=.35,ranksep=.5]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#EFF5EA",color="#315B46",margin=".15,.1"];edge [fontname="DejaVu Sans",fontsize=9,color="#54745F",arrowsize=.7];rankdir=TB;catalog[label="Catálogo\nBuscar / gestionar"];cart[label="Carrito\nCantidades / total"];client[label="Cliente\nDatos para cotizar"];quote[label="Cotizaciones\nPrecio congelado"];pending[label="Pedido pendiente"];sent[label="Enviado"];done[label="Entregado"];cancel[label="Cancelado\nDevolver inventario"];catalog->cart[label="añadir"];cart->client[label="si faltan datos"];client->cart[label="guardar y volver"];cart->quote[label="guardar"];quote->pending[label="confirmar"];pending->sent[label="registrar envío"];sent->done[label="registrar entrega"];pending->cancel[label="cancelar"];}
